# core-crm environment. Copy to .env and adjust.

# When set, the service uses Postgres (runs migrations on boot).
# When unset, it uses the in-memory repository (dev/tests only).
DATABASE_URL=postgres://postgres:dev@localhost:5432/abetverticals

# HMAC secret for verifying request JWTs. Change in every real environment.
JWT_SECRET=dev-secret-change-me

# HTTP port.
PORT=3001
